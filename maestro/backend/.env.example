# Copiar este archivo como .env y completar los valores

# ── Anthropic (Claude API) ────────────────────────────────────────────────────
# Obtener en console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar (haiku es más rápido y económico; opus 4 es el más potente)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite por defecto (desarrollo local):
DATABASE_URL=sqlite:///./projects.db
#
# Para Supabase (producción) → copiá la connection string de:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA usar el valor por defecto en producción.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Entorno ───────────────────────────────────────────────────────────────────
# "development" → /docs habilitado, sin HSTS
# "production"  → /docs deshabilitado, HSTS activado
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ── Rate limiting ─────────────────────────────────────────────────────────────
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_MAX_HISTORY_TURNS=20

# ══════════════════════════════════════════════════════════════════════════════
# INTEGRACIONES EXTERNAS (todas opcionales)
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (SDK Python — opcional si ya usás DATABASE_URL de Supabase) ──────
# Obtener en Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=eyJ...

# ── Google Drive + Calendar ───────────────────────────────────────────────────
# El mismo credenciales.json del proyecto SCBA (service account).
# La cuenta de servicio debe tener:
#   - Drive: carpeta compartida con el email del service account
#   - Calendar: calendario compartido con el email del service account (rol Editor)
# Scopes necesarios: drive.file, calendar.events
GOOGLE_CREDENTIALS_PATH=C:\Users\M01\Desktop\credenciales.json
# ID de la carpeta raíz en Drive donde se crearán subcarpetas por proyecto
# (click derecho en la carpeta → compartir → copiar link → el ID es el último segmento)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# ID del calendario (usar "primary" para el principal, o el ID de un calendario específico)
GOOGLE_CALENDAR_ID=primary

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token → github.com/settings/tokens
# Scopes: "repo" (repos privados) o "public_repo" (solo públicos)
GITHUB_TOKEN=ghp_...

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Proveedor: "twilio" | "meta"
WHATSAPP_PROVIDER=twilio

# --- Twilio (proveedor recomendado) ---
# Obtener en console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de WhatsApp de MAESTRO (formato: "whatsapp:+XXXXXXXXXXX")
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Configurar webhook en Twilio Console:
#   Messaging → Senders → WhatsApp sandbox → Webhook URL:
#   https://tu-dominio.com/whatsapp/webhook (POST)

# --- Meta Cloud API (alternativa) ---
# Obtener en developers.facebook.com → WhatsApp → API Setup
META_WHATSAPP_TOKEN=EAAxxxxxxx...
META_WHATSAPP_PHONE_ID=1234567890
# Token de verificación para el webhook (elegí uno seguro)
META_WEBHOOK_VERIFY_TOKEN=maestro-webhook-token

# Configurar webhook en Meta Developers:
#   WhatsApp → Configuration → Webhook URL: https://tu-dominio.com/whatsapp/webhook
#   Verify Token: el valor de META_WEBHOOK_VERIFY_TOKEN
