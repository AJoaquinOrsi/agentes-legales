# ============================================================================
# MAESTRO - Variables de Entorno
# ============================================================================

# Entorno
ENVIRONMENT=production
IS_PRODUCTION=true

# Base de datos
DATABASE_URL=postgresql://maestro_user:maestro_password@postgres:5432/maestro_db

# JWT / Autenticación
JWT_SECRET=cambiar-esto-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Claude API
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLAUDE_MODEL=claude-sonnet-4-6

# Google
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/google-service-account.json

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+...

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://tudominio.com

# Redis
REDIS_URL=redis://redis:6379/0

# Logs
LOG_LEVEL=INFO
LOG_FILE=/app/logs/maestro.log

# Otros
MAX_UPLOAD_SIZE=20971520
UPLOADS_DIR=/app/uploads