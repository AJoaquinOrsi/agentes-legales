# ══════════════════════════════════════════════════════════════════════
#  Foliar — Variables de entorno
#  Copiá este archivo como ".env" y completá los valores.
#  NUNCA subas el .env a git (ya está en .gitignore).
# ══════════════════════════════════════════════════════════════════════

# ── Requerido ──────────────────────────────────────────────────────────
# API Key de Anthropic (obtenela en https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-PONELA-AQUI

# Clave secreta de Flask para firmar las cookies de sesión.
# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=GENERALA-CON-EL-COMANDO-DE-ARRIBA

# ── Producción ─────────────────────────────────────────────────────────
# Activar modo producción (cookies seguras, sin debug, etc.)
FOLIAR_ENV=production

# ── Opcionales ─────────────────────────────────────────────────────────
# Modelo Claude a usar (si no se pone, usa claude-sonnet-4-6)
# Opciones: claude-sonnet-4-6 | claude-haiku-4-5 | claude-opus-4-5
# FOLIAR_MODEL=claude-sonnet-4-6

# Nombre del estudio que aparece en la pantalla de login
# FOLIAR_ESTUDIO=Estudio Arrechea

# Puerto del servidor (por defecto 5000)
# PORT=5000
